COMPOSE_PROJECT_NAME=hut-beta
POSTGRES_DB=hut
POSTGRES_USER=hut
POSTGRES_PASSWORD=replace-with-url-safe-hex-generated-by-openssl
ALTCHA_HMAC_SECRET=replace-with-different-hex-generated-by-openssl
TLS_DIR=/opt/hut/secrets/tls

# Only direct, non-Compose development commands use this value. Compose builds
# its own URL with the service hostname "db" and the POSTGRES_* values above.
DATABASE_URL=postgresql://hut:replace-with-url-safe-hex-generated-by-openssl@localhost:5432/hut
